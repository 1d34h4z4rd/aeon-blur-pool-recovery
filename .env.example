# Blur Pool upgrade environment configuration.
#
# Copy to `.env` and fill in values:
#   cp .env.example .env
#
# The Makefile reads this file directly, so do not quote values; quotes would
# become part of the value (for example, write MNEMONIC=word word ... word).

# --- Fork ---

# Mainnet RPC URL. It must serve historical state (an archive node), since the
# fork is pinned to FORK_BLOCK. Defaults to https://rpc.flashbots.net for
# forking; `make deploy` requires your own.
MAINNET_RPC_URL=

# The pinned fork block. Defaults to the block the tests were written against.
# FORK_BLOCK=26357000

# --- Mainnet deployment (`make deploy` and `make verify`) ---

# Signer for the permissionless implementation deployment. An explicit
# 0x-prefixed private key takes precedence over a mnemonic (index 0).
PRIVATE_KEY=
MNEMONIC=

# Etherscan API key for verifying the implementation.
ETHERSCAN_API_KEY=
